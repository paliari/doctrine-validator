{
    "name": "paliari/doctrine-validator",
    "description": "Advanced model validator for Doctrine ORM (based on ActiveRecord)",
    "version": "5.0.0",
    "type": "library",
    "homepage": "https://github.com/paliari/doctrine-validator",
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^2.20 || ^3.0",
        "paliari/php-utils": "^2.0.2 || ^3.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Marcos Paliari",
            "email": "marcos@paliari.com.br"
        }
    ],
    "autoload": {
        "psr-4": {
            "Paliari\\Doctrine\\": "src"
        }
    },
    "require-dev": {
        "doctrine/dbal": "^3.2 || ^4.0",
        "doctrine/persistence": "^3.1 || ^4.0",
        "phpunit/phpunit": "^11.5",
        "symfony/var-exporter": "^6.4 || ^7.0 || ^8.0"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "php -d pcov.enabled=1 -d pcov.directory=src vendor/bin/phpunit --coverage-text"
    }
}